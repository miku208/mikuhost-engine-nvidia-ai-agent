{
  "name": "mikuhost-agent",
  "version": "1.2.0",
  "description": "MikuHost Agent - a local-first, multi-provider AI coding agent for the terminal (NVIDIA, Token Harbor, OpenAI-compatible)",
  "type": "module",
  "bin": {
    "mikuhost": "bin/mikuhost.mjs",
    "mikuhost-agent": "bin/mikuhost.mjs"
  },
  "main": "src/index.mjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/mikuhost.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "doctor": "node bin/mikuhost.mjs doctor"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "nvidia",
    "tokenharbor",
    "openai-compatible",
    "coding-assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^6.0.1",
    "react": "^19.0.0"
  }
}
